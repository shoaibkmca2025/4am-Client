# Copy to ".env" (on the VPS or locally) and fill in. This single file is
# read at BUILD time (VITE_* → baked into the browser bundle) AND at RUNTIME
# by the Node server. Never commit the filled-in .env — it holds secrets.

# ── Client (Vite exposes only VITE_* to the browser) ─────────────
VITE_GEMINI_API_KEY=            # existing AI chatbot
VITE_SUPABASE_URL=              # https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=         # publishable key — safe to ship, RLS enforces access

# ── Server-only (NEVER exposed to the client) ───────────────────
SUPABASE_URL=                   # https://<project>.supabase.co
SUPABASE_ANON_KEY=              # anon/publishable key (RLS applies)
SUPABASE_SERVICE_ROLE_KEY=      # service role — server only, bypasses RLS
SERVER_HMAC_SECRET=             # long random string; signs certificate verification hashes
SITE_URL=https://4amglobalmedia.com   # used in QR codes, canonical URLs, OG tags

# ── Self-hosted server (VPS) — optional, sensible defaults ───────
HOST=127.0.0.1                  # bind address; keep localhost behind nginx
PORT=8080                       # port the Node server listens on

# ── Email / chat alerts (all optional; leads still save without them) ──
RESEND_API_KEY=                 # lead/application email alerts
LEAD_NOTIFY_TO=                 # where alerts go, e.g. Info@4amglobalmedia.com
EMAIL_FROM=                     # verified Resend sender, e.g. "4AM <notifications@4amglobalmedia.com>"
SLACK_WEBHOOK_URL=              # Slack incoming webhook for lead/application pings
WHATSAPP_WEBHOOK_URL=           # any endpoint accepting {message} (CallMeBot/n8n bridge)

# ── Database (only needed to run migrations: npm run db:migrate) ──
DATABASE_URL=                   # Supabase pooled connection string
DIRECT_URL=                     # Supabase direct connection string
