# ── Client (Vite exposes only VITE_* to the browser) ─────────────
VITE_GEMINI_API_KEY=            # existing AI chatbot
VITE_SUPABASE_URL=              # https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=         # publishable key — safe to ship, RLS enforces access

# ── Server-only (Vercel env vars; NEVER exposed to the client) ───
SUPABASE_URL=                   # https://<project>.supabase.co
SUPABASE_ANON_KEY=              # anon public key (RLS applies)
SUPABASE_SERVICE_ROLE_KEY=      # service role — server only, bypasses RLS
SERVER_HMAC_SECRET=             # long random string; signs certificate verification hashes
RESEND_API_KEY=                 # optional (lead/application email alerts)
LEAD_NOTIFY_TO=                 # optional (where alerts go)
EMAIL_FROM=                     # optional (verified Resend sender, e.g. "4AM <notifications@4amglobalmedia.com>")
SLACK_WEBHOOK_URL=              # optional (Slack incoming webhook for lead/application pings)
WHATSAPP_WEBHOOK_URL=           # optional (any endpoint accepting {message}, e.g. CallMeBot/n8n bridge)
